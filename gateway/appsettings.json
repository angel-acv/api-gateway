{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5000",
  "ReverseProxy": {
    "Routes": {
      "ruta_ventas": {
        "ClusterId": "cluster_ventas",
        "Match": {
          "Path": "/ventas/{**catch-all}"
        }
      },
      "ruta_inventario": {
        "ClusterId": "cluster_inventario",
        "Match": {
          "Path": "/inventario/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "cluster_ventas": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": "true",
            "Interval": "00:00:05",
            "Timeout": "00:00:02",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": "true",
            "ReactivationInterval": "00:00:10"
          }
        },
        "Destinations": {
          "instancia_primaria": {
            "Address": "http://localhost:5001/"
          },
          "instancia_secundaria": {
            "Address": "http://localhost:5002/"
          },
          "instancia_terciaria": {
            "Address": "http://localhost:5005/"
          }
        }
      },
      "cluster_inventario": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": "true",
            "Interval": "00:00:05",
            "Timeout": "00:00:02",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": "true",
            "ReactivationInterval": "00:00:10"
          }
        },
        "Destinations": {
          "instancia_inventario_1": {
            "Address": "http://localhost:5003/"
          }
        }
      }
    }
  }
}